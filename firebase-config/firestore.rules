rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profissionais - só o próprio profissional pode ler/escrever seus dados
    match /profissionais/{profissionalId} {
      allow read, write: if request.auth != null && request.auth.uid == profissionalId;
    }
    
    // Clientes - só o profissional dono pode acessar
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.profissionalId;
      allow create: if request.auth != null && request.auth.uid == request.data.profissionalId;
    }
    
    // Agendamentos - só o profissional dono pode acessar
    match /agendamentos/{agendamentoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.profissionalId;
      allow create: if request.auth != null && request.auth.uid == request.data.profissionalId;
    }
    
    // Financeiro - só o profissional dono pode acessar
    match /financeiro/{transacaoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.profissionalId;
      allow create: if request.auth != null && request.auth.uid == request.data.profissionalId;
    }
    
    // Anamneses - só o profissional dono pode acessar
    match /anamneses/{anamnesesId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.profissionalId;
      allow create: if request.auth != null && request.auth.uid == request.data.profissionalId;
    }
    
    // Feed posts - leitura pública, escrita só pelo autor
    match /feedPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.profissionalId;
      allow create: if request.auth != null && request.auth.uid == request.data.profissionalId;
    }
  }
}
