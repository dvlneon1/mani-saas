{
  "build": {
    "env": {
      "NEXT_PUBLIC_FIREBASE_API_KEY": "@mani-firebase-api-key",
      "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@mani-firebase-auth-domain",
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@mani-firebase-project-id",
      "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "@mani-firebase-storage-bucket",
      "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "@mani-firebase-messaging-sender-id",
      "NEXT_PUBLIC_FIREBASE_APP_ID": "@mani-firebase-app-id",
      "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "@mani-firebase-measurement-id"
    }
  },
  "functions": {
    "apps/admin-web/**/*.{js,ts,jsx,tsx}": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/apps/admin-web/.next/$1"
    }
  ]
}
